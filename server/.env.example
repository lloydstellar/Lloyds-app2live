# Settings of la2l-server. Copy this file to .env and change what you need; every line shows
# the default. compose.yaml reads .env; without it the defaults below hold.

# Port inside the container. compose.yaml publishes it on 127.0.0.1:8787 only.
PORT=8787
# Address inside the container.
HOST=0.0.0.0
# Database and package files. compose.yaml mounts the volume la2l-data here.
DATA_DIR=/data
# LA2L's Maven repository, served at /la2l/maven/. compose.yaml mounts the volume la2l-maven
# here, read-only; deploy/maven-sync.sh fills it.
MAVEN_DIR=/maven
# The public address, only for the log. The server never builds absolute addresses.
PUBLIC_URL=https://lloydstellar.nl/la2l
# 1: take the client address from the last X-Forwarded-For entry (set by the web server).
# 0: use the address of the connection.
TRUST_PROXY=1
# How long a pairing code works, in seconds (30 to 1800).
PAIR_TTL_SECONDS=600
# How often the device asks for the pairing status while a code shows, in ms (500 to 10000).
POLL_MS=2000
# Packages are deleted this long after upload, imported or not, in hours (at most 24).
PACKAGE_TTL_HOURS=24
# A package that is not committed this long after it was made is deleted, in minutes.
UPLOAD_TTL_MINUTES=60
# How long an app can still read the result of a package, in days.
RESULT_TTL_DAYS=7
# Waiting packages of one computer may take this much space together, in MB.
MAX_DEVICE_STORAGE_MB=1024
# Packages sent from one address (an IPv6 address counts by its /64) may take this much space
# together while they upload or wait, in MB.
MAX_ADDRESS_STORAGE_MB=2048
# All packages together, in MB. Keep it well below the free space of the disk: above it, the
# server refuses new packages, long before the disk is full.
MAX_TOTAL_STORAGE_MB=10240
# A warning in the log, at most once an hour, when the packages take more than this share of
# MAX_TOTAL_STORAGE_MB, in percent.
STORAGE_WARN_PERCENT=80
# Uploads are refused when less than this would be free on the disk afterwards, in MB.
MIN_FREE_DISK_MB=2048
# off only in tests.
RATE_LIMITS=on
